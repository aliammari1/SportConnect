# is commented out by default.
#.vscode/
.kiro

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

.mcp.json
.sisyphus/
scripts/
.claude
.agents
.omx
.omo
.cursor
.opencode
opencode.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# iOS provisioning profiles (managed via Apple Developer Portal or CI)
/ios/provisioning/*.mobileprovision

# iOS certificates - NEVER commit private keys
/ios/certs/*.key
# Certificate files can be re-downloaded from Apple Developer Portal
/ios/certs/*.cer
# Certificate Requests can be re-downloaded from Apple Developer Portal
/ios/certs/*.csr

*.md
*.txt
marketing
.emulator-data
