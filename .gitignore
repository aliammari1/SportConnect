# Environment files (NEVER commit sensitive keys!)
.env
.env.local
.env.*.local
functions/.env
*.env

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
