rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdminOrSupport() {
      return isAuthenticated() &&
        (
          request.auth.token.admin == true ||
          request.auth.token.support == true ||
          request.auth.token.refunds == true ||
          request.auth.token.role == 'admin' ||
          request.auth.token.role == 'support'
        );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCurrentUserPremium() {
      return isAuthenticated() && getUserData().isPremium == true;
    }

    function isEventGroupChat(chatData) {
      return chatData.type == 'eventGroup';
    }

    // Membership invariant: ensureEventGroupChat only ever adds premium
    // users to an eventGroup chat's participantIds, so read paths check
    // membership alone; premium stays enforced on create/membership writes.
    // Event participants count as members even before the merge lands,
    // otherwise message reads fail with permission-denied for them.
    function isChatParticipant(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;

      return isAuthenticated() &&
        (
          request.auth.uid in chat.participantIds ||
          (
            'eventId' in chat &&
            chat.eventId is string &&
            request.auth.uid in get(
              /databases/$(database)/documents/events/$(chat.eventId)
            ).data.participantIds
          )
        );
    }

    // Server-side block enforcement for 1:1 chats: the recipient's
    // blockedUsers list decides, regardless of what the sending client
    // checks. Group chats rely on leave/report flows instead.
    function isBlockedRecipient(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
      let isPrivatePair = chat.type == 'private' &&
        chat.participantIds.size() == 2;
      let otherUid = chat.participantIds[0] == request.auth.uid
        ? chat.participantIds[1]
        : chat.participantIds[0];
      let other = get(/databases/$(database)/documents/users/$(otherUid)).data;
      return isPrivatePair &&
        'blockedUsers' in other &&
        request.auth.uid in other.blockedUsers;
    }

    function isPassengerBookingCreate() {
      return isAuthenticated() &&
        request.resource.data.passengerId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        !('paymentIntentId' in request.resource.data) &&
        !('paidAt' in request.resource.data);
    }

    function isPassengerBookingUpdate() {
      return isAuthenticated() &&
        resource.data.passengerId == request.auth.uid &&
        changedKeys().hasOnly([
          'status',
          'respondedAt',
          'updatedAt',
          'cancellationReason',
          'cancelledAt'
        ]) &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.rideId == resource.data.rideId &&
        request.resource.data.passengerId == resource.data.passengerId &&
        request.resource.data.driverId == resource.data.driverId;
    }

    function isDriverBookingUpdate(rideId) {
      return isAuthenticated() &&
        (
          resource.data.driverId == request.auth.uid ||
          get(/databases/$(database)/documents/rides/$(rideId)).data.driverId == request.auth.uid
        ) &&
        changedKeys().hasOnly([
          'status',
          'respondedAt',
          'updatedAt',
          'pickupOtp',
          'cancellationReason',
          'cancelledAt'
        ]) &&
        request.resource.data.rideId == resource.data.rideId &&
        request.resource.data.passengerId == resource.data.passengerId &&
        request.resource.data.driverId == resource.data.driverId;
    }

    function isOwnRideStatusUpdate() {
      return changedKeys().hasOnly(['rideStatuses', 'updatedAt']) &&
        request.resource.data.rideStatuses
          .diff(resource.data.rideStatuses)
          .affectedKeys()
          .hasOnly([request.auth.uid]);
    }

    function isJoiningEvent() {
      return changedKeys().hasOnly(['participantIds', 'updatedAt']) &&
        !(request.auth.uid in resource.data.participantIds) &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.participantIds.size() == resource.data.participantIds.size() + 1 &&
        request.resource.data.participantIds.hasAll(resource.data.participantIds) &&
        (
          resource.data.maxParticipants == 0 ||
          request.resource.data.participantIds.size() <= resource.data.maxParticipants
        );
    }

    function isLeavingEvent() {
      return (
          changedKeys().hasOnly(['participantIds', 'updatedAt']) ||
          changedKeys().hasOnly(['participantIds', 'rideStatuses', 'updatedAt'])
        ) &&
        request.auth.uid in resource.data.participantIds &&
        !(request.auth.uid in request.resource.data.participantIds) &&
        request.resource.data.participantIds.size() == resource.data.participantIds.size() - 1 &&
        resource.data.participantIds.hasAll(request.resource.data.participantIds) &&
        (
          !changedKeys().hasAny(['rideStatuses']) ||
          request.resource.data.rideStatuses
            .diff(resource.data.rideStatuses)
            .affectedKeys()
            .hasOnly([request.auth.uid])
        );
    }

    function isMeetupPinUpdate() {
      return changedKeys().hasOnly([
        'meetupPinLocation',
        'updatedAt'
      ]);
    }

    function isLinkedRideUpdate() {
      return changedKeys().hasOnly([
        'linkedRideIds',
        'updatedAt'
      ]) &&
        request.resource.data.linkedRideIds is list &&
        (
          // Exactly one element added or removed relative to the
          // current value (mirrors arrayUnion/arrayRemove semantics).
          (
            request.resource.data.linkedRideIds.size() == resource.data.linkedRideIds.size() + 1 &&
            request.resource.data.linkedRideIds.hasAll(resource.data.linkedRideIds)
          ) ||
          (
            request.resource.data.linkedRideIds.size() == resource.data.linkedRideIds.size() - 1 &&
            resource.data.linkedRideIds.hasAll(request.resource.data.linkedRideIds)
          )
        );
    }

    // Constrains a bookingIds-only ride update to exactly one element added or
    // removed (arrayUnion/arrayRemove semantics), so a non-driver booker can
    // attach/detach their own booking without being able to wipe the array or
    // bulk-inject arbitrary ids.
    function isSingleBookingIdDelta() {
      return changedKeys().hasOnly(['bookingIds', 'updatedAt']) &&
        request.resource.data.bookingIds is list &&
        (
          (
            request.resource.data.bookingIds.size() == resource.data.bookingIds.size() + 1 &&
            request.resource.data.bookingIds.hasAll(resource.data.bookingIds)
          ) ||
          (
            request.resource.data.bookingIds.size() == resource.data.bookingIds.size() - 1 &&
            resource.data.bookingIds.hasAll(request.resource.data.bookingIds)
          )
        );
    }

    // Returns the value of a star bucket on a (possibly missing) rating map,
    // defaulting to 0 so the comparison works even when the rating map or an
    // individual bucket has never been written.
    function ratingBucket(data, bucket) {
      return data.get('rating', {}).get(bucket, 0);
    }

    // True when exactly one star bucket changed by +1 or -1 and every other
    // bucket is unchanged. This constrains the cross-user `rating` update so a
    // client can only apply a single legitimate review increment/decrement and
    // cannot forge arbitrary aggregate values (R-D6).
    function isSingleStarBucketDelta() {
      let deltas = [
        ratingBucket(request.resource.data, 'fiveStars') - ratingBucket(resource.data, 'fiveStars'),
        ratingBucket(request.resource.data, 'fourStars') - ratingBucket(resource.data, 'fourStars'),
        ratingBucket(request.resource.data, 'threeStars') - ratingBucket(resource.data, 'threeStars'),
        ratingBucket(request.resource.data, 'twoStars') - ratingBucket(resource.data, 'twoStars'),
        ratingBucket(request.resource.data, 'oneStars') - ratingBucket(resource.data, 'oneStars')
      ];
      // Sum of absolute deltas must be exactly 1: i.e. one bucket moved by ±1
      // and all others stayed put.
      let absSum = math.abs(deltas[0]) + math.abs(deltas[1]) + math.abs(deltas[2]) +
        math.abs(deltas[3]) + math.abs(deltas[4]);
      return absSum == 1;
    }

    // Owner profile self-update: the document owner may write their own profile
    // but server-controlled fields must remain unchanged. isPremium / isBanned
    // (entitlement and moderation state) and the rating aggregate are owned by
    // trusted server code and cannot be set from the client to prevent premium
    // self-grant, ban evasion, and reputation forgery.
    //
    // Uses .get(field, default) rather than a bare dot dereference so the rule
    // also works for 'pending' accounts, whose document legitimately omits
    // isPremium and rating (PendingUserModel never serializes them). A bare
    // request.resource.data.isPremium on such a doc raises an evaluation error
    // that DENIES the write — which is what blocked Sign in with Apple users on
    // the role-selection screen (they self-update selectedRoleIntent /
    // onboardingPath while role is still 'pending'). The security intent is
    // unchanged: this is an equality gate (new == old), so a client can only
    // ever re-write a field to the value it already holds. Introducing
    // isPremium=true (or any forged rating) makes new != old (true != false,
    // forged-map != {}) and is still denied.
    //
    // The role is also immutable on this branch: a user's role never changes
    // after it is set. The ONLY sanctioned role write is the one-time
    // pending -> rider/driver conversion handled by isRoleFinalization(); every
    // other owner self-update (role-intent save, profile edits, fcmToken, etc.)
    // must keep role identical, so rider<->driver switching is impossible.
    function isOwnerProfileUpdate() {
      return request.resource.data.get('role', '') == resource.data.get('role', '') &&
        request.resource.data.get('isPremium', false) == resource.data.get('isPremium', false) &&
        request.resource.data.get('isBanned', false) == resource.data.get('isBanned', false) &&
        request.resource.data.get('rating', {}) == resource.data.get('rating', {});
    }

    // True when every star bucket on the (possibly missing) rating map is zero,
    // i.e. a brand-new, un-forged reputation. Used by the role-finalization
    // branch below so converting a pending account cannot seed a fake rating.
    function isFreshRating(data) {
      return ratingBucket(data, 'fiveStars') == 0 &&
        ratingBucket(data, 'fourStars') == 0 &&
        ratingBucket(data, 'threeStars') == 0 &&
        ratingBucket(data, 'twoStars') == 0 &&
        ratingBucket(data, 'oneStars') == 0;
    }

    // Role finalization: a pending account converting itself into a real
    // rider/driver profile. This is the ONLY branch that may change `role`
    // (isOwnerProfileUpdate() pins role as immutable), and it is a full-document
    // overwrite that legitimately INTRODUCES server-owned fields (isPremium,
    // rating) the pending doc never had — so isOwnerProfileUpdate()'s equality
    // checks can't model it (the introduced fresh rating map differs from the
    // pending doc's absent one). The security intent is preserved explicitly:
    // premium can only land as false (no self-grant), the moderation flag is
    // carried over unchanged (no ban evasion), and the rating must be
    // fresh/zeroed (no reputation forgery). Because resource.data.role must be
    // 'pending', this is a one-time conversion and can never run again.
    function isRoleFinalization() {
      return resource.data.get('role', '') == 'pending' &&
        (
          request.resource.data.role == 'rider' ||
          request.resource.data.role == 'driver'
        ) &&
        request.resource.data.get('isPremium', false) == false &&
        request.resource.data.isBanned == resource.data.isBanned &&
        isFreshRating(request.resource.data);
    }

    function isCreatorEventEdit() {
      return changedKeys().hasOnly([
        'title',
        'type',
        'location',
        'startsAt',
        'endsAt',
        'description',
        'organizerName',
        'imageUrl',
        'maxParticipants',
        'isActive',
        'meetupPinLocation',
        'chatGroupId',
        'isRecurring',
        'recurringPattern',
        'recurringEndDate',
        'costSplitEnabled',
        'updatedAt'
      ]) &&
        request.resource.data.creatorId == resource.data.creatorId;
    }

    // ---------------------------------------------------------------------
    // Users
    // ---------------------------------------------------------------------

    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isOwner(userId);

      allow update: if (isOwner(userId) && (isOwnerProfileUpdate() || isRoleFinalization())) ||
        (
          // Cross-user rating aggregate: only a single legitimate star-bucket
          // increment/decrement is allowed, so a client cannot forge arbitrary
          // rating values on another user (R-D6). Self-targeted rating deltas
          // are forbidden so a user cannot inflate their own reputation.
          isAuthenticated() &&
          userId != request.auth.uid &&
          changedKeys().hasOnly(['rating']) &&
          isSingleStarBucketDelta()
        ) ||
        (
          // Cross-user gamification update (e.g. a completing ride's driver
          // client awarding XP to ride participants). Left as-is; not part of
          // the rating aggregate. This relies on client-side XP logic and
          // should ideally move to a trusted Cloud Function — see notes.
          isAuthenticated() &&
          changedKeys().hasOnly(['gamification'])
        );

      allow delete: if isOwner(userId);

      match /blockedUsers/{blockedUserId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---------------------------------------------------------------------
    // Rides
    // ---------------------------------------------------------------------

    match /rides/{rideId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
        request.resource.data.driverId == request.auth.uid;

      allow update: if isAuthenticated() &&
        (
          resource.data.driverId == request.auth.uid ||
          isSingleBookingIdDelta()
        );

      allow delete: if isAuthenticated() &&
        resource.data.driverId == request.auth.uid;

      match /bookings/{bookingId} {
        allow read: if isAuthenticated() &&
          (
            resource.data.passengerId == request.auth.uid ||
            resource.data.driverId == request.auth.uid ||
            get(/databases/$(database)/documents/rides/$(rideId)).data.driverId == request.auth.uid
          );

        allow create: if isPassengerBookingCreate();

        allow update: if isAuthenticated() &&
          (
            isPassengerBookingUpdate() ||
            isDriverBookingUpdate(rideId)
          );

        allow delete: if isAuthenticated() &&
          resource.data.passengerId == request.auth.uid;
      }
    }

    // ---------------------------------------------------------------------
    // Top-level bookings
    // ---------------------------------------------------------------------

    match /bookings/{bookingId} {
      allow read: if isAuthenticated() &&
        (
          resource.data.passengerId == request.auth.uid ||
          resource.data.driverId == request.auth.uid ||
          get(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.driverId == request.auth.uid
        );

      allow create: if isPassengerBookingCreate();

      allow update: if isAuthenticated() &&
        (
          isPassengerBookingUpdate() ||
          isDriverBookingUpdate(resource.data.rideId)
        );

      allow delete: if isAuthenticated() &&
        resource.data.passengerId == request.auth.uid;
    }

    // Collection-group compatible bookings rule.
    match /{path=**}/bookings/{bookingId} {
      allow read: if isAuthenticated() &&
        (
          resource.data.passengerId == request.auth.uid ||
          resource.data.driverId == request.auth.uid ||
          get(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.driverId == request.auth.uid
        );

      allow create: if isPassengerBookingCreate();

      allow update: if isAuthenticated() &&
        (
          isPassengerBookingUpdate() ||
          isDriverBookingUpdate(resource.data.rideId)
        );

      allow delete: if isAuthenticated() &&
        resource.data.passengerId == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // Chats
    // ---------------------------------------------------------------------

    match /chats/{chatId} {
      allow get: if isAuthenticated() &&
        (
          resource == null ||
          (
            request.auth.uid in resource.data.participantIds
          ) ||
          (
            'eventId' in resource.data &&
            resource.data.eventId is string &&
            request.auth.uid in get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.participantIds
          )
        );

      allow list: if isAuthenticated() &&
        request.auth.uid in resource.data.participantIds;

      allow create: if isAuthenticated() &&
        (
          (
            request.auth.uid in request.resource.data.participantIds &&
            (!isEventGroupChat(request.resource.data) || isCurrentUserPremium())
          ) ||
          (
            'eventId' in request.resource.data &&
            request.resource.data.eventId is string &&
            request.auth.uid in get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.participantIds &&
            (!isEventGroupChat(request.resource.data) || isCurrentUserPremium())
          )
        );

      allow update: if isAuthenticated() &&
        (
          // User-specific chat settings + own read cursor.
          (
            request.auth.uid in resource.data.participantIds &&
            changedKeys().hasOnly([
              'mutedUntil',
              'pinnedBy',
              'hiddenBy',
              'clearedAt',
              'members',
              'updatedAt'
            ])
          ) ||

          // Message send preview update. Membership ('participantIds') is
          // deliberately excluded here so a preview update cannot add/remove
          // chat members; membership changes go through the dedicated
          // "Remove self" and "Event chat membership" branches below. On an
          // existing chat the client never includes participantIds in this
          // update (it is only written on the create path).
          (
            request.auth.uid in resource.data.participantIds &&
            changedKeys().hasOnly([
              'lastMessageContent',
              'lastMessageSenderId',
              'lastMessageType',
              'lastMessageAt',
              'updatedAt',
              'hiddenBy'
            ]) &&
            request.resource.data.lastMessageSenderId == request.auth.uid
          ) ||

          // Remove self from chat.
          // Remove self from chat (also clears own member state entry).
          (
            request.auth.uid in resource.data.participantIds &&
            changedKeys().hasOnly(['participantIds', 'members', 'updatedAt']) &&
            request.resource.data.participantIds.size() == resource.data.participantIds.size() - 1 &&
            resource.data.participantIds.hasAll(request.resource.data.participantIds) &&
            !(request.auth.uid in request.resource.data.participantIds)
          ) ||

          // Event chat membership/metadata update.
          (
            'eventId' in resource.data &&
            resource.data.eventId is string &&
            request.auth.uid in get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.participantIds &&
            (!isEventGroupChat(resource.data) || isCurrentUserPremium()) &&
            changedKeys().hasOnly(['participantIds','members','updatedAt']) &&
            request.resource.data.type == resource.data.type &&
            request.resource.data.eventId == resource.data.eventId &&
            request.resource.data.premiumOnly == resource.data.premiumOnly &&
            request.resource.data.isActive == resource.data.isActive
          )
        );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          isChatParticipant(chatId);

        allow create: if isAuthenticated() &&
          isChatParticipant(chatId) &&
          !isBlockedRecipient(chatId) &&
          request.resource.data.senderId == request.auth.uid;

        allow update: if isAuthenticated() &&
          isChatParticipant(chatId) &&
          (
            resource.data.senderId == request.auth.uid ||
            changedKeys().hasOnly([
              'readBy',
              'deliveredTo',
              'reactions',
              'status',
              'updatedAt'
            ])
          );

        allow delete: if false;
      }

      match /typing/{typingId} {
        allow read: if isAuthenticated() &&
          isChatParticipant(chatId);
        // typingId is the typist's uid; scoping writes to it prevents one
        // participant from planting or deleting another's indicator.
        allow write: if isAuthenticated() &&
          isChatParticipant(chatId) &&
          request.auth.uid == typingId;
      }
    }

    // ---------------------------------------------------------------------
    // Notifications
    // ---------------------------------------------------------------------

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // Vehicles
    // ---------------------------------------------------------------------

    match /vehicles/{vehicleId} {
      // Owners read their own vehicles for management, AND any authenticated
      // user (e.g. a passenger on an active ride) may read a driver's vehicle
      // so the safety photo-match card can stream the driver's vehicle via
      // where('ownerId', ==, driverId). Vehicle data here is non-sensitive
      // (make/model/plate/photo) and rides are already readable by any
      // authenticated user, so this aligns the rule with the real passenger
      // read pattern (userVehiclesStreamProvider(driverId)).
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid;

      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        (
          // User-editable fields from the management/edit form.
          changedKeys().hasOnly([
            'make', 'model', 'year', 'color', 'licensePlate',
            'capacity', 'imageUrl', 'imageUrls', 'isActive', 'updatedAt'
          ]) ||
          // Stats aggregation path (updateVehicleStats): the owner may update
          // only the aggregate counters and timestamp. Maintained client-side
          // via a Firestore transaction for now; ideally moved to a trusted
          // Cloud Function later.
          changedKeys().hasOnly([
            'totalRides', 'averageRating', 'updatedAt'
          ])
        );

      allow delete: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // Driver stats
    // ---------------------------------------------------------------------

    match /driver_stats/{driverId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && driverId == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // Hotspots / Leaderboard
    // ---------------------------------------------------------------------

    match /hotspots/{hotspotId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /leaderboard/{entryId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // Transactions
    // ---------------------------------------------------------------------

    match /transactions/{transactionId} {
      allow read: if isAuthenticated() &&
        (
          resource.data.driverId == request.auth.uid ||
          resource.data.riderId == request.auth.uid
        );

      // Ledger entries are server-owned. Writes happen exclusively from Cloud
      // Functions / Stripe webhook handlers via the Admin SDK so amounts, status
      // and payout fields cannot be fabricated or altered from the client.
      allow create, update, delete: if false;
    }

    match /{path=**}/transactions/{transactionId} {
      allow read: if isAuthenticated() &&
        (
          resource.data.driverId == request.auth.uid ||
          resource.data.riderId == request.auth.uid
        );

      // Ledger entries are server-owned (see above).
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Stripe connected accounts
    // ---------------------------------------------------------------------

    match /driver_connected_accounts/{userId} {
      allow read: if isAuthenticated() &&
        userId == request.auth.uid;

      // Server-owned snapshot. Cloud Functions/Admin SDK only.
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Ride requests
    // ---------------------------------------------------------------------

    match /rideRequests/{requestId} {
      allow read: if isAuthenticated() &&
        (
          resource.data.riderId == request.auth.uid ||
          resource.data.driverId == request.auth.uid
        );

      allow create: if isAuthenticated() &&
        request.resource.data.riderId == request.auth.uid;

      // Either party may update, but the identity fields are immutable so
      // neither can re-target the request to a different rider/driver.
      allow update: if isAuthenticated() &&
        (
          resource.data.riderId == request.auth.uid ||
          resource.data.driverId == request.auth.uid
        ) &&
        request.resource.data.riderId == resource.data.riderId &&
        request.resource.data.driverId == resource.data.driverId;

      allow delete: if isAuthenticated() &&
        (
          resource.data.riderId == request.auth.uid ||
          resource.data.driverId == request.auth.uid
        );
    }

    // ---------------------------------------------------------------------
    // Top-level standalone messages
    // ---------------------------------------------------------------------

    match /messages/{messageId} {
      allow read: if isAuthenticated() &&
        (
          resource.data.senderId == request.auth.uid ||
          resource.data.receiverId == request.auth.uid
        );

      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid;

      allow update: if isAuthenticated() &&
        resource.data.senderId == request.auth.uid;

      allow delete: if isAuthenticated() &&
        resource.data.senderId == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // Reviews
    // ---------------------------------------------------------------------

    match /reviews/{reviewId} {
      allow read: if isAuthenticated();

      // Self-review prevention is enforced here (R-D6); completed-paid-seat
      // eligibility and no-duplicate constraints require querying bookings,
      // which Security Rules cannot do and must live in a Cloud Function.
      allow create: if isAuthenticated() &&
        request.resource.data.reviewerId == request.auth.uid &&
        request.resource.data.reviewerId != request.resource.data.revieweeId &&
        request.resource.data.revieweeId is string &&
        request.resource.data.rideId is string &&
        // rating is a double in [1, 5] (use `is number` since whole-number
        // ratings serialize as doubles, not ints). Validated at create time
        // because rating is made immutable on update and reviews are
        // world-readable, so a bad value would otherwise be permanent.
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;

      // The identity and rating fields are immutable on update so a client can
      // neither re-target a review nor alter its rating after the fact (R-D6).
      allow update: if isAuthenticated() &&
        resource.data.reviewerId == request.auth.uid &&
        request.resource.data.reviewerId == resource.data.reviewerId &&
        request.resource.data.revieweeId == resource.data.revieweeId &&
        request.resource.data.rideId == resource.data.rideId &&
        request.resource.data.rating == resource.data.rating;

      allow delete: if isAuthenticated() &&
        resource.data.reviewerId == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // Events
    // ---------------------------------------------------------------------

    match /events/{eventId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
        request.resource.data.creatorId == request.auth.uid;

      allow update: if isAuthenticated() &&
        (
          (resource.data.creatorId == request.auth.uid && isCreatorEventEdit()) ||

          isJoiningEvent() ||

          isLeavingEvent() ||

          (
            request.auth.uid in resource.data.participantIds &&
            isOwnRideStatusUpdate()
          ) ||

          (
            request.auth.uid in resource.data.participantIds &&
            isMeetupPinUpdate()
          ) ||

          (
            request.auth.uid in resource.data.participantIds &&
            isLinkedRideUpdate()
          )
        );

      allow delete: if isAuthenticated() &&
        resource.data.creatorId == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // Payments / Payouts
    // ---------------------------------------------------------------------

    match /payments/{paymentId} {
      allow read: if isAuthenticated() &&
        (
          resource.data.riderId == request.auth.uid ||
          resource.data.driverId == request.auth.uid ||
          isAdminOrSupport()
        );

      allow create, update, delete: if false;
    }

    match /refund_requests/{requestId} {
      allow read: if isAuthenticated() &&
        (
          resource.data.requesterId == request.auth.uid ||
          isAdminOrSupport()
        );

      allow create, update, delete: if false;
    }

    match /payouts/{payoutId} {
      allow read: if isAuthenticated() &&
        resource.data.driverId == request.auth.uid;

      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Disputes
    // ---------------------------------------------------------------------

    match /disputes/{disputeId} {
      allow read: if isAuthenticated() &&
        (
          resource.data.complainantId == request.auth.uid ||
          resource.data.respondentId == request.auth.uid ||
          isAdminOrSupport()
        );

      allow create: if isAuthenticated() &&
        request.resource.data.complainantId == request.auth.uid;

      allow update: if isAuthenticated() &&
        (
          (
            resource.data.complainantId == request.auth.uid &&
            changedKeys().hasOnly([
              'description',
              'attachmentUrls',
              'updatedAt'
            ])
          ) ||
          (
            resource.data.respondentId == request.auth.uid &&
            changedKeys().hasOnly([
              'respondentResponse',
              'respondentEvidence',
              'updatedAt'
            ])
          )
        );

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // Reports
    // ---------------------------------------------------------------------

    match /reports/{reportId} {
      allow read: if isAuthenticated() &&
        (
          resource.data.reporterId == request.auth.uid ||
          isAdminOrSupport()
        );

      allow create: if isAuthenticated() &&
        request.resource.data.reporterId == request.auth.uid;

      allow update, delete: if false;
    }

    // Ops-console reads: audit trail and platform config are written by the
    // Admin SDK only; platform admins get read access from the client.
    match /admin_audit/{auditId} {
      allow read: if isAuthenticated() && isAdminOrSupport();
      allow write: if false;
    }

    match /config/{configId} {
      allow read: if isAuthenticated() && isAdminOrSupport();
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // Support tickets
    // ---------------------------------------------------------------------

    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() &&
        (
          resource.data.userId == request.auth.uid ||
          isAdminOrSupport()
        );

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      allow delete: if false;
    }
  }
}

